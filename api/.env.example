NODE_ENV=development
PORT=3014
DATABASE_URL=postgresql://praca:praca@localhost:5437/praca?schema=public
JWT_SECRET=dev-secret-change-me-please
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:3024
PUBLIC_URL=http://localhost:3014
APP_URL=http://localhost:3024
CADENCE_ENGINE_ENABLED=true
# `true` SÓ atrás de proxy reverso (nginx): faz o Fastify ler X-Forwarded-For,
# que é o que dá um balde de throttle por visitante em vez de um para o mundo
# inteiro. Sem proxy na frente, `false` — senão qualquer um forja o próprio IP.
TRUST_PROXY=false
# Teto do formulário público por minuto/IP. Em produção fica 10.
PUBLIC_LEADS_PER_MINUTE=60
# Integração com o Freela (api-freela). Sem as três, /v1/freela/* responde 503.
FREELA_API_URL=
FREELA_ADMIN_EMAIL=
FREELA_ADMIN_PASSWORD=
# Só ligue depois de o api-freela de produção aceitar contacts[].message.
FREELA_PER_CONTACT_MESSAGE=false
FREELA_SYNC_ENABLED=true
# Consultores de campo (bloco A) — ver README, "Consultores de campo"
# URL BASE do Freela web, sem /cadastro e sem barra no fim (ex.: https://www.freelaservicos.com.br).
# Link do QR code: ${FREELA_WEB_URL}/cadastro?consultor=CÓDIGO (vazio = sem QR)
FREELA_WEB_URL=
# Validade do acesso do consultor no celular
CAMPO_JWT_EXPIRES_IN=7d
# Fotos das fachadas: vazio = s3 em produção / disk nos demais ambientes (ou force s3 | disk)
PHOTO_STORAGE=
PHOTOS_DIR=./uploads
# Bucket S3 PRIVADO (produção). Chaves vazias = cadeia padrão do SDK (papel da instância)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Pesquisa automática de estabelecimentos (contrato §22). OSM/Overpass não usa chave; vazio = padrão.
OVERPASS_URL=
# Identificação exigida pelas instâncias públicas do Overpass (vazio = praca-freela/1.0 + contato)
PLACES_USER_AGENT=
# Apify (opcional, pago): só funciona com APIFY_ENABLED=true E APIFY_TOKEN. O token é segredo:
# digite só no servidor (.env de produção), nunca em código, commit ou documentação.
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places
APIFY_MAX_PLACES_PER_RUN=300
APIFY_MONTHLY_PLACES_CAP=3000
# Roteiro do dia do consultor (contrato §23): true liga rota, paradas, pular/adiar e refazer rota.
# Meta, horários e velocidade NÃO são env: ficam em app_settings.field_config (tela de configuração).
FIELD_ROUTES_ENABLED=false
# Cadastro assistido da empresa visitada no Freela (contrato §26): true liga "Cadastrar no Freela" na visita.
# Pré-condições: api-freela com as rotas de cadastro assistido (e a flag lá), página /primeiro-acesso no freela-web-v2.
FIELD_COMPANY_SIGNUP_ENABLED=false
# Só em NODE_ENV=production: senha da conta admin criada pelo `npm run seed`
# (mínimo 8 caracteres). Sem ela o seed recusa rodar. Em produção o seed cria a
# praça real sem dados de exemplo (sem leads, mídia nem progresso inventado).
SEED_ADMIN_PASSWORD=
# Só em produção: e-mail do admin (obrigatório) e, opcionais, os da Rebeca e do Mkt externo.
# Em produção Rebeca e Mkt nascem com senha aleatória — o admin define em Configurações → Pessoas.
SEED_ADMIN_EMAIL=
SEED_REBECA_EMAIL=
SEED_MKT_EMAIL=
