generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── pessoas ──────────────────────────────────────────────────
model users {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  password_hash   String
  name            String
  role_label      String   @default("")
  color           String   @default("#ECA826")
  phone           String   @default("")
  is_admin        Boolean  @default(false)
  active          Boolean  @default(true)
  theme           String   @default("dark")
  active_praca_id String?  @db.Uuid
  sort            Int      @default(0)
  created_at      DateTime @default(now())

  dismissed_notifs          user_dismissed_notifs[]
  field_consultants_created field_consultants[]
  field_areas_created       field_areas[]
  place_runs_requested      place_import_runs[]
  route_plans_created       field_route_plans[]
}

model user_dismissed_notifs {
  user_id  String   @db.Uuid
  notif_id String
  at       DateTime @default(now())
  user     users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, notif_id])
}

// ── praça ────────────────────────────────────────────────────
model pracas {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  city             String
  start_date       String
  end_date         String
  cobertura_uf     String?
  cobertura_cidade String?
  cobertura_ibge   String?
  lat              Float?
  lon              Float?
  vizinhas         String[] @default([])
  created_at       DateTime @default(now())

  step_states       praca_step_states[]
  actions           actions[]
  leads             leads[]
  proofs            proofs[]
  campanhas         campanhas[]
  field_consultants field_consultants[]
  field_areas       field_areas[]
  place_import_runs place_import_runs[]
  route_plans       field_route_plans[]
}

model praca_step_states {
  praca_id      String    @db.Uuid
  step_n        Int
  actual        Float?
  unlocked_by   String?   @db.Uuid
  unlocked_at   DateTime?
  unlock_reason String?
  praca         pracas    @relation(fields: [praca_id], references: [id], onDelete: Cascade)

  @@id([praca_id, step_n])
}

// ── roteiro-modelo e ações ───────────────────────────────────
model template_actions {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  step           Int
  title          String
  owners         String[] @default([])
  rec_kind       String
  rec_day        Int?
  rec_start_day  Int?
  rec_end_day    Int?
  rec_weekday    Int?
  rec_month_day  Int?
  tools          String[] @default([])
  how_to         String[] @default([])
  expected       String?
  msg            String?
  attention      String?
  expects_result Boolean  @default(false)
  sort           Int      @default(0)
}

model actions {
  id             String    @id @default(uuid()) @db.Uuid
  praca_id       String    @db.Uuid
  template_key   String?
  step           Int
  title          String
  owners         String[]  @default([])
  rec_kind       String
  rec_day        Int?
  rec_start_day  Int?
  rec_end_day    Int?
  rec_weekday    Int?
  rec_month_day  Int?
  tools          String[]  @default([])
  expected       String?
  msg            String?
  attention      String?
  expects_result Boolean   @default(false)
  due_override   String?
  postpone_count Int       @default(0)
  completed_at   DateTime?
  completed_by   String?   @db.Uuid
  result         Float?
  sort           Int       @default(0)
  created_at     DateTime  @default(now())
  praca          pracas    @relation(fields: [praca_id], references: [id], onDelete: Cascade)

  completions action_completions[]
  comments    action_comments[]
  subitems    action_subitems[]

  @@index([praca_id, step])
}

model action_completions {
  action_id String   @db.Uuid
  date      String
  by        String   @db.Uuid
  at        DateTime @default(now())
  result    Float?
  action    actions  @relation(fields: [action_id], references: [id], onDelete: Cascade)

  @@id([action_id, date])
}

model action_comments {
  id        String   @id @default(uuid()) @db.Uuid
  action_id String   @db.Uuid
  author_id String   @db.Uuid
  at        DateTime @default(now())
  text      String
  action    actions  @relation(fields: [action_id], references: [id], onDelete: Cascade)
}

model action_subitems {
  id        String  @id @default(uuid()) @db.Uuid
  action_id String  @db.Uuid
  text      String
  done      Boolean @default(false)
  sort      Int     @default(0)
  action    actions @relation(fields: [action_id], references: [id], onDelete: Cascade)
}

// ── indicadores ──────────────────────────────────────────────
model indicator_entries {
  praca_id String @db.Uuid
  key      String
  date     String
  value    Float

  @@id([praca_id, key, date])
}

// ── funil ────────────────────────────────────────────────────
model leads {
  id                 String              @id @default(uuid()) @db.Uuid
  praca_id           String?             @db.Uuid
  name               String
  city               String              @default("")
  address            String              @default("")
  phone              String              @default("")
  phone_key          String              @default("")
  cnpj               String?
  instagram          String?
  site               String?
  decisor            String              @default("—")
  decisor_role       String              @default("")
  classe             String              @default("alvo")
  origem             String              @default("prospecção")
  owner_id           String?             @db.Uuid
  stage              Int                 @default(1)
  entered_at         String
  stage_since        String
  last_contact_at    DateTime?
  next_step_what     String?
  next_step_date     String?
  lost_reason        String?
  reheat_at          String?
  archived           Boolean             @default(false)
  import_batch_id    String?             @db.Uuid
  possible_dup       Boolean             @default(false)
  snooze_until       String?
  campanha_id        String?             @db.Uuid
  form_answer        String?
  is_test            Boolean             @default(false)
  // Localização do estabelecimento (§5). Nula nos que já existiam; o bloco B
  // preenche em massa; a visita de campo grava a do check-in no lead novo.
  lat                Float?
  lng                Float?
  // Origem técnica do lead criado pela pesquisa automática (F2): `source` = fonte
  // ('osm' | 'apify'), `source_ref` = id externo, `location_precision` = 'point'.
  // Nulos nos leads antigos; NULLs não conflitam no UNIQUE abaixo.
  source             String?
  source_ref         String?
  location_precision String?
  // Shoppings (lote D, §40.7): `place_kind = 'shopping'` no lead do shopping; `parent_lead_id` nas lojas de dentro. Nulos em todo
  // lead existente e com a flag desligada.
  place_kind         String?
  parent_lead_id     String?             @db.Uuid
  created_at         DateTime            @default(now())
  praca              pracas?             @relation(fields: [praca_id], references: [id], onDelete: SetNull)
  place_candidates   place_candidates[]
  parent             leads?              @relation("LojasDoShopping", fields: [parent_lead_id], references: [id], onDelete: SetNull)
  stores             leads[]             @relation("LojasDoShopping")
  mall_metrics       lead_mall_metrics?
  store_searches     place_import_runs[] @relation("BuscasDeLojas")
  route_plans        field_route_plans[]

  events           lead_events[]
  vagas            lead_vagas[]
  sends            msg_sends[]
  enrollments      enrollments[]
  field_visits     field_visits[]
  route_stops      field_route_stops[]
  company_signups  field_company_signups[]
  signups_freela   field_signups[]
  declared_signups field_declared_signups[]
  vouchers         field_vouchers[]

  @@unique([source, source_ref])
  @@index([praca_id, lat, lng])
  @@index([praca_id, stage])
  @@index([phone_key])
  @@index([import_batch_id])
  @@index([parent_lead_id])
  @@index([praca_id, place_kind])
  // Prova social do render (`{{estabelecimento_vizinho}}`): os primeiros por
  // nome de cada cidade, numa consulta só para o lote inteiro.
  @@index([city, name])
}

model lead_events {
  id           String   @id @default(uuid()) @db.Uuid
  lead_id      String   @db.Uuid
  at           DateTime @default(now())
  author_id    String?  @db.Uuid
  author_label String?
  kind         String
  text         String
  stage_to     Int?
  lead         leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, at])
}

model lead_vagas {
  id      String  @id @default(uuid()) @db.Uuid
  lead_id String  @db.Uuid
  date    String
  funcao  String
  filled  Boolean @default(false)
  hours   Float?
  lead    leads   @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model import_mappings {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  map        Json
  created_at DateTime @default(now())
}

model import_batches {
  id        String   @id @default(uuid()) @db.Uuid
  at        DateTime @default(now())
  file_name String
  by        String   @db.Uuid
  origem    String
  imported  Int
  ignored   Int
  reasons   String[] @default([])
}

// ── mensagens ────────────────────────────────────────────────
model msg_templates {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  audience        String
  stage           Int      @default(0)
  channel         String   @default("whatsapp")
  text_a          String
  text_b          String?
  attachment_kind String?
  attachment_name String?
  attachment_url  String?
  created_at      DateTime @default(now())
}

model app_settings {
  id                Int     @id @default(1)
  mode              String  @default("fila")
  window_start      Int     @default(9)
  window_end        Int     @default(19)
  sunday            Boolean @default(false)
  daily_limit       Int     @default(200)
  gap_min           Int     @default(20)
  gap_max           Int     @default(90)
  daily_quota       Int     @default(20)
  template_defaults Json    @default("{}")
  field_channels    Json    @default("[\"Nenhum\",\"Grupos de WhatsApp\",\"Indicação de conhecidos\",\"Agência de mão de obra\"]")
  // Parâmetros de negócio do campo (roteiro, F3; a F5 acrescenta chaves). Ver contrato §23.1.
  field_config      Json    @default("{}")
  // Segmentos editáveis da busca (lote C, contrato §36): { segments, atualizado_por, atualizado_em }; nulo = padrão do código.
  place_segments    Json?
}

model blocklist {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  phone_key String   @unique
  name      String   @default("")
  lead_id   String?  @db.Uuid
  at        DateTime @default(now())
  reason    String   @default("")
}

model disparos {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  at                 DateTime @default(now())
  scheduled_at       DateTime
  mode               String
  template_id        String   @db.Uuid
  split              Boolean  @default(false)
  channel            String
  by                 String   @db.Uuid
  filters            Json
  skipped_block      Int      @default(0)
  skipped_dup        Int      @default(0)
  status             String   @default("agendado")
  freela_campaign_id String?

  sends msg_sends[]
}

model msg_sends {
  id                  String    @id @default(uuid()) @db.Uuid
  disparo_id          String?   @db.Uuid
  cadence_id          String?   @db.Uuid
  node_id             String?   @db.Uuid
  enrollment_id       String?   @db.Uuid
  template_id         String?   @db.Uuid
  variant             String    @default("A")
  lead_id             String    @db.Uuid
  channel             String    @default("whatsapp")
  text                String
  mode                String    @default("fila")
  scheduled_at        DateTime
  sent_at             DateTime?
  replied_at          DateTime?
  status              String    @default("fila")
  failure_reason      String?
  stage_at_send       Int
  freela_campaign_id  String?
  freela_recipient_id String?
  created_at          DateTime  @default(now())
  disparo             disparos? @relation(fields: [disparo_id], references: [id], onDelete: Cascade)
  lead                leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([disparo_id])
  @@index([lead_id])
  @@index([status, mode])
  @@index([freela_campaign_id])
  // Limite diário das cadências: quantas mensagens já saíram hoje (Brasília).
  @@index([sent_at])
}

// ── cadências ────────────────────────────────────────────────
model cadences {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  audience    String
  entry       String
  exit_action String
  exit_note   String   @default("")
  paused      Boolean  @default(false)
  created_at  DateTime @default(now())

  nodes       cadence_nodes[]
  enrollments enrollments[]
}

model cadence_nodes {
  id          String   @id @default(uuid()) @db.Uuid
  cadence_id  String   @db.Uuid
  sort        Int
  kind        String
  day         Int      @default(0)
  channel     String?
  template_id String?  @db.Uuid
  text        String?
  task        String?
  rule        String?
  action      String?
  note        String?
  cadence     cadences @relation(fields: [cadence_id], references: [id], onDelete: Cascade)

  @@index([cadence_id, sort])
}

model enrollments {
  id             String   @id @default(uuid()) @db.Uuid
  cadence_id     String   @db.Uuid
  lead_id        String   @db.Uuid
  started_at     DateTime
  next_at        DateTime
  status         String   @default("ativo")
  exit_reason    String?
  stage_at_start Int
  is_test        Boolean  @default(false)
  compress_sec   Int?
  cadence        cadences @relation(fields: [cadence_id], references: [id], onDelete: Cascade)
  lead           leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  logs enrollment_logs[]

  @@index([cadence_id, status])
  @@index([lead_id, status])
  // A consulta do relógio a cada 15 s: quem está ativo e já venceu.
  @@index([status, next_at])
}

model enrollment_logs {
  id            String      @id @default(uuid()) @db.Uuid
  enrollment_id String      @db.Uuid
  node_id       String      @db.Uuid
  at            DateTime    @default(now())
  send_id       String?     @db.Uuid
  kind          String
  enrollment    enrollments @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
}

// ── mídia ────────────────────────────────────────────────────
model proofs {
  id       String @id @default(uuid()) @db.Uuid
  praca_id String @db.Uuid
  kind     String
  title    String
  praca    pracas @relation(fields: [praca_id], references: [id], onDelete: Cascade)

  campanhas campanha_provas[]
}

model campanhas {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  praca_id       String    @db.Uuid
  publico        String
  objetivo       String
  start          String
  end            String
  verba          Float     @default(0)
  gasto          Float     @default(0)
  dor            String    @default("")
  oferta         String    @default("")
  mensagem_chave String    @default("")
  destino        String    @default("formulario")
  kpi_name       String    @default("")
  kpi_meta       Float     @default(0)
  kpi_custo      Float     @default(0)
  cac_teto       Float     @default(0)
  status         String    @default("rascunho")
  gate_just_by   String?
  gate_just_at   DateTime?
  gate_just_text String?
  created_at     DateTime  @default(now())
  praca          pracas    @relation(fields: [praca_id], references: [id], onDelete: Cascade)

  provas    campanha_provas[]
  creatives creatives[]
  traffic   traffic_entries[]
}

model campanha_provas {
  campanha_id String    @db.Uuid
  proof_id    String    @db.Uuid
  campanha    campanhas @relation(fields: [campanha_id], references: [id], onDelete: Cascade)
  proof       proofs    @relation(fields: [proof_id], references: [id], onDelete: Cascade)

  @@id([campanha_id, proof_id])
}

model creatives {
  id                      String    @id @default(uuid()) @db.Uuid
  campanha_id             String    @db.Uuid
  formato                 String
  titulo                  String    @default("")
  gancho                  String    @default("")
  roteiro_gancho          String    @default("")
  roteiro_desenvolvimento String    @default("")
  roteiro_prova           String    @default("")
  roteiro_cta             String    @default("")
  legenda                 String    @default("")
  cta_botao               String    @default("Saiba mais")
  owner_id                String?   @db.Uuid
  due                     String
  publish_at              String?
  status                  String    @default("a_fazer")
  file_url                String    @default("")
  ia_tool                 String?
  ia_prompt               String?
  approved_at             DateTime?
  created_at              DateTime  @default(now())
  campanha                campanhas @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  comments creative_comments[]
}

model creative_comments {
  id          String    @id @default(uuid()) @db.Uuid
  creative_id String    @db.Uuid
  at          DateTime  @default(now())
  author      String
  text        String
  kind        String
  creative    creatives @relation(fields: [creative_id], references: [id], onDelete: Cascade)
}

model traffic_entries {
  id            String    @id @default(uuid()) @db.Uuid
  campanha_id   String    @db.Uuid
  plataforma    String
  nome_la       String    @default("")
  publico       String    @default("")
  geo           String    @default("")
  verba_diaria  Float     @default(0)
  criativos     String[]  @default([])
  manager_url   String    @default("")
  api_connected Boolean   @default(false)
  campanha      campanhas @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  days traffic_days[]
}

model traffic_days {
  id         String          @id @default(uuid()) @db.Uuid
  entry_id   String          @db.Uuid
  date       String
  investido  Float           @default(0)
  alcance    Int             @default(0)
  cliques    Int             @default(0)
  conversoes Int             @default(0)
  auto       Boolean         @default(false)
  entry      traffic_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, date])
}

// ── integração Freela ────────────────────────────────────────
model freela_campaigns {
  id               String    @id @default(uuid()) @db.Uuid
  freela_id        String    @unique
  name             String
  kind             String
  praca_id         String?   @db.Uuid
  disparo_id       String?   @db.Uuid
  audience         String
  audience_filters Json?
  status           String
  stats            Json?
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now())
  last_synced_at   DateTime?
}

model freela_templates {
  id         String   @id @default(uuid()) @db.Uuid
  freela_id  String   @unique
  praca_id   String?  @db.Uuid
  created_by String   @db.Uuid
  created_at DateTime @default(now())
}

// ── consultores de campo (spec 2026-10-08) ───────────────────
model field_consultants {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  email                String    @unique
  phone                String    @default("")
  cpf                  String    @unique
  praca_id             String    @db.Uuid
  pix_key              String
  pix_key_type         String
  password_hash        String
  must_change_password Boolean   @default(true)
  token_version        Int       @default(0)
  active               Boolean   @default(true)
  freela_consultant_id String?
  freela_code          String?
  freela_sync_error    String?
  freela_synced_at     DateTime?
  // Exceção por consultor do fluxo da visita (contrato §31.3): simples | completo; nulo = seguir o padrão.
  visit_flow           String?
  created_by           String    @db.Uuid
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  praca                pracas    @relation(fields: [praca_id], references: [id], onDelete: Restrict)
  creator              users     @relation(fields: [created_by], references: [id], onDelete: Restrict)

  journeys         field_journeys[]
  visits           field_visits[]
  routes           field_routes[]
  company_signups  field_company_signups[]
  signups          field_signups[]
  declared_signups field_declared_signups[]
  signup_sync      field_signup_sync_state?
  earnings         field_earnings_ledger[]
  payout_periods   field_payout_periods[]
  payouts          field_payouts[]
  journey_breaks   field_journey_breaks[]
  vouchers         field_vouchers[]
  plan_items       field_route_plan_items[]
}

model field_journeys {
  id             String            @id @default(uuid()) @db.Uuid
  consultant_id  String            @db.Uuid
  day            String
  client_id      String            @unique @db.Uuid
  started_at     DateTime
  start_lat      Float
  start_lng      Float
  start_accuracy Float
  ended_at       DateTime?
  end_lat        Float?
  end_lng        Float?
  end_accuracy   Float?
  auto_closed    Boolean           @default(false)
  created_at     DateTime          @default(now())
  consultant     field_consultants @relation(fields: [consultant_id], references: [id], onDelete: Cascade)

  points field_points[]
  visits field_visits[]
  breaks field_journey_breaks[]

  // Mais o índice único PARCIAL `field_journeys_one_open_per_consultant`
  // (SQL cru na migração — o Prisma 5 não declara índice parcial).
  @@index([consultant_id, day])
  @@index([day])
}

/// Lote B da Lovable (contrato §37.3): intervalo/almoço como evento da jornada. Idempotente por `client_id` (início) e
/// `end_client_id` (fim). Mais o índice único PARCIAL `field_journey_breaks_one_open_per_journey` (SQL cru na migração).
model field_journey_breaks {
  id             String            @id @default(uuid()) @db.Uuid
  journey_id     String            @db.Uuid
  consultant_id  String            @db.Uuid
  client_id      String            @unique @db.Uuid
  end_client_id  String?           @unique @db.Uuid
  started_at     DateTime
  ended_at       DateTime?
  start_lat      Float?
  start_lng      Float?
  start_accuracy Float?
  end_lat        Float?
  end_lng        Float?
  end_accuracy   Float?
  /// manual | checkin | journey_end | auto
  end_reason     String?
  auto_closed    Boolean           @default(false)
  clock_adjusted Boolean           @default(false)
  created_at     DateTime          @default(now())
  journey        field_journeys    @relation(fields: [journey_id], references: [id], onDelete: Cascade)
  consultant     field_consultants @relation(fields: [consultant_id], references: [id], onDelete: Cascade)

  @@index([consultant_id, started_at])
  @@index([journey_id])
}

model field_points {
  id             String         @id @default(uuid()) @db.Uuid
  journey_id     String         @db.Uuid
  at             DateTime
  received_at    DateTime       @default(now())
  lat            Float
  lng            Float
  accuracy       Float
  kind           String
  client_id      String         @unique @db.Uuid
  clock_adjusted Boolean        @default(false)
  journey        field_journeys @relation(fields: [journey_id], references: [id], onDelete: Cascade)

  @@index([journey_id, at])
}

model field_visits {
  id                String                  @id @default(uuid()) @db.Uuid
  client_id         String                  @unique @db.Uuid
  journey_id        String                  @db.Uuid
  consultant_id     String                  @db.Uuid
  lead_id           String                  @db.Uuid
  checkin_at        DateTime
  checkin_lat       Float
  checkin_lng       Float
  checkin_accuracy  Float
  distance_m        Int?
  far_from_place    Boolean                 @default(false)
  photo_key         String
  photo_bytes       Int
  checkout_at       DateTime?
  checkout_lat      Float?
  checkout_lng      Float?
  auto_closed       Boolean                 @default(false)
  clock_adjusted    Boolean                 @default(false)
  interlocutor_name String?
  interlocutor_role String?
  freela_status     String?
  interest          String?
  open_vagas        Int?
  vaga_roles        String[]                @default([])
  freelas_per_week  Int?
  channels          String[]                @default([])
  channel_other     String?
  needs_followup    Boolean?
  followup_what     String?
  followup_date     String?
  notes             String?
  // P0 comparação Lovable (contrato §30): resultado da visita, motivo de recusa, hora do retorno, telefone do contato.
  outcome           String                  @default("conversa") // conversa | fechado
  refusal_reason    String? // slug de MOTIVOS_RECUSA (domain/catalog/refusal.ts)
  refusal_note      String?
  followup_time     String? // HH:mm (Brasília)
  contact_phone     String? // só dígitos (10–11); nunca em log
  // Modo do chefe S1 (contrato §31): fluxo gravado na abertura da visita (simples | completo), o resultado
  // escolhido no fluxo simples (cadastrou | ja_usa | retorno | sem_interesse | fechado) e a justificativa de distância.
  flow              String                  @default("completo")
  result            String?
  distance_note     String?
  // Lote B da Lovable (contrato §35.3): foto do checklist no check-in ({ required, items: [{ id, text, done, note }] }).
  checklist         Json?
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt
  journey           field_journeys          @relation(fields: [journey_id], references: [id], onDelete: Cascade)
  consultant        field_consultants       @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  lead              leads                   @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  route_stops       field_route_stops[]
  company_signups   field_company_signups[]
  declared_signup   field_declared_signups?
  vouchers          field_vouchers[]

  // Mais o índice único PARCIAL `field_visits_one_open_per_consultant`.
  @@index([consultant_id, checkin_at])
  @@index([journey_id])
  // Cobertura (§24): "este lead teve visita no período?" — a FK não tinha índice.
  @@index([lead_id])
}

// ── áreas de atuação do campo (F1 da prospecção) ─────────────
// Círculo (centro + raio) dentro de uma praça. O CHECK de raio 200–5000 vive só
// no SQL da migração (o Prisma não declara CHECK).
model field_areas {
  id         String   @id @default(uuid()) @db.Uuid
  praca_id   String   @db.Uuid
  name       String
  name_key   String
  lat        Float
  lng        Float
  radius_m   Int
  active     Boolean  @default(true)
  created_by String   @db.Uuid
  created_at DateTime @default(now())

  praca   pracas @relation(fields: [praca_id], references: [id], onDelete: Cascade)
  creator users  @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@unique([praca_id, name_key])
  @@index([praca_id, active])
}

// F2 da prospecção (contrato §22): uma pesquisa de estabelecimentos numa área.
// `cache_key` = hash da geometria + tipos + fonte; reaproveitada por 7 dias.
model place_import_runs {
  id                String    @id @default(uuid()) @db.Uuid
  praca_id          String    @db.Uuid
  area_id           String    @db.Uuid
  area_name         String
  source            String
  types             String[]
  lat               Float
  lng               Float
  radius_m          Int
  cache_key         String
  status            String    @default("queued") // queued | running | done | error | cancelled
  found             Int       @default(0)
  novos             Int       @default(0)
  duplicados        Int       @default(0)
  descartados       Int       @default(0)
  truncated         Boolean   @default(false)
  // Apify: lugares reservados ao começar (teto mensal); o actor cobra mesmo se cancelarmos.
  reserved_places   Int       @default(0)
  est_cost_usd      Float     @default(0)
  error             String?
  requested_by      String    @db.Uuid
  created_at        DateTime  @default(now())
  started_at        DateTime?
  finished_at       DateTime?
  // Foto das definições dos segmentos pedidos (lote C, §36.6); nulo = tipos fixos de hoje.
  segments_snapshot Json?
  // Lote D (§40.3): lugares (a de hoje) | shoppings | lojas (dentro do shopping `parent_lead_id`).
  kind              String    @default("lugares")
  parent_lead_id    String?   @db.Uuid

  praca      pracas             @relation(fields: [praca_id], references: [id], onDelete: Cascade)
  requester  users              @relation(fields: [requested_by], references: [id], onDelete: Restrict)
  parent     leads?             @relation("BuscasDeLojas", fields: [parent_lead_id], references: [id], onDelete: SetNull)
  candidates place_candidates[]

  @@index([praca_id, created_at(sort: Desc)])
  @@index([cache_key, status, finished_at])
  @@index([source, status, finished_at])
}

// Achado de uma pesquisa, antes de virar lead. `status`: novo | duplicado |
// descartado | adicionado. O mesmo ponto do OSM aparece em buscas diferentes,
// por isso a unicidade é por busca.
model place_candidates {
  id                 String   @id @default(uuid()) @db.Uuid
  run_id             String   @db.Uuid
  source             String
  source_ref         String
  name               String
  category           String
  address            String   @default("")
  lat                Float
  lng                Float
  location_precision String   @default("point")
  phone              String   @default("")
  website            String?
  distance_m         Int
  status             String   @default("novo")
  reason             String?
  lead_id            String?  @db.Uuid
  // Lote D (§40.3): métricas do shopping achado (`{geometry_kind, area_m2, levels}`); nulo nos demais.
  metrics            Json?
  created_at         DateTime @default(now())

  run         place_import_runs   @relation(fields: [run_id], references: [id], onDelete: Cascade)
  lead        leads?              @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  route_stops field_route_stops[]

  @@unique([run_id, source, source_ref])
  @@index([run_id, status])
}

// ── roteiro do dia (F3 da prospecção, contrato §23) ──────────
// Um roteiro ATIVO por consultor por dia: o índice único parcial
// `field_routes_one_active_per_day (consultant_id, day) WHERE status = 'ativa'`
// vive só no SQL da migração (o Prisma não declara índice parcial).
// `praca_id` e `area_id` são colunas simples (sem FK): a praça do roteiro é a do
// consultor e áreas nunca são apagadas.
model field_routes {
  id              String   @id @default(uuid()) @db.Uuid
  consultant_id   String   @db.Uuid
  praca_id        String   @db.Uuid
  area_id         String?  @db.Uuid
  day             String
  status          String   @default("ativa") // ativa | encerrada
  version         Int      @default(1)
  source          String // equipe | auto | consultor
  travel_mode     String   @default("a_pe") // a_pe | carro (contrato §30.4)
  start_lat       Float
  start_lng       Float
  params_snapshot Json
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  consultant field_consultants        @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  stops      field_route_stops[]
  events     field_route_events[]
  plan_items field_route_plan_items[]

  @@index([consultant_id, day])
  @@index([day, praca_id])
}

// `day` repete o dia do roteiro para o índice único parcial
// `field_route_stops_lead_day_unique (lead_id, day) WHERE status IN ('pendente','visitada','adiada')`
// (só no SQL): dois consultores nunca recebem o mesmo lugar no dia.
model field_route_stops {
  id              String   @id @default(uuid()) @db.Uuid
  route_id        String   @db.Uuid
  lead_id         String   @db.Uuid
  day             String
  seq             Int
  kind            String   @default("planejada") // planejada | reserva
  status          String   @default("pendente") // pendente | visitada | pulada | adiada | descartada
  fixa            Boolean  @default(false)
  eta_min         Int?
  planned_minutes Int
  distance_m      Int      @default(0)
  skip_reason     String?
  skip_note       String?
  deferred_to     String? // tarde | amanha
  visit_id        String?  @db.Uuid
  candidate_id    String?  @db.Uuid
  name_snap       String
  address_snap    String   @default("")
  phone_snap      String   @default("")
  lat_snap        Float
  lng_snap        Float
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  route     field_routes         @relation(fields: [route_id], references: [id], onDelete: Cascade)
  lead      leads                @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  visit     field_visits?        @relation(fields: [visit_id], references: [id], onDelete: SetNull)
  candidate place_candidates?    @relation(fields: [candidate_id], references: [id], onDelete: SetNull)
  events    field_route_events[]

  @@index([route_id, seq])
  @@index([lead_id])
}

// Histórico append-only das ações do consultor no roteiro; `client_id` único = idempotência.
model field_route_events {
  id            String   @id @default(uuid()) @db.Uuid
  route_id      String   @db.Uuid
  stop_id       String?  @db.Uuid
  consultant_id String   @db.Uuid
  client_id     String   @unique @db.Uuid
  kind          String // skip | defer | undo | reoptimize
  reason        String?
  note          String?
  at            DateTime
  created_at    DateTime @default(now())

  route field_routes       @relation(fields: [route_id], references: [id], onDelete: Cascade)
  stop  field_route_stops? @relation(fields: [stop_id], references: [id], onDelete: SetNull)

  @@index([route_id, created_at])
}

/// Cadastro assistido da empresa visitada no Freela (F6, contrato §26). NUNCA guarda o link de
/// primeiro acesso nem senha: só o fato da emissão, telefone/e-mail mascarados e o userId do Freela.
model field_company_signups {
  id                   String            @id @default(uuid()) @db.Uuid
  client_id            String            @unique @db.Uuid
  consultant_id        String            @db.Uuid
  visit_id             String?           @db.Uuid
  lead_id              String?           @db.Uuid
  company_name         String
  phone_masked         String
  email_masked         String?
  status               String            @default("creating")
  freela_user_id       String?
  freela_contractor_id String?
  link_issued_at       DateTime?
  link_expires_at      DateTime?
  reissue_count        Int               @default(0)
  activated_at         DateTime?
  last_error_code      String?
  last_error           String?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  consultant           field_consultants @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  visit                field_visits?     @relation(fields: [visit_id], references: [id], onDelete: SetNull)
  lead                 leads?            @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  confirmados          field_signups[]

  @@index([consultant_id, created_at])
  @@index([visit_id])
  @@index([lead_id])
}

// ── cadastros confirmados pelo Freela (F7 da prospecção, contrato §27) ──
// Fatos imutáveis: as datas de evento são escritas uma vez (só preenchem nulo). Sem
// telefone/e-mail/CNPJ do Freela. O CHECK de `match_status` vive só no SQL da migração.
model field_signups {
  id                     String                 @id @default(uuid()) @db.Uuid
  consultant_id          String                 @db.Uuid
  freela_user_id         String
  freela_contractor_id   String?
  company_name           String
  source                 String?
  freela_created_at      DateTime
  activated_at           DateTime?
  first_vacancy_at       DateTime?
  first_job_completed_at DateTime?
  created_day            String
  activated_day          String?
  first_vacancy_day      String?
  first_job_day          String?
  signup_id              String?                @db.Uuid
  lead_id                String?                @db.Uuid
  match_status           String                 @default("none")
  first_seen_at          DateTime               @default(now())
  synced_at              DateTime
  updated_at             DateTime               @updatedAt
  consultant             field_consultants      @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
  signup                 field_company_signups? @relation(fields: [signup_id], references: [id], onDelete: SetNull)
  lead                   leads?                 @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@unique([consultant_id, freela_user_id])
  @@index([consultant_id, activated_day])
  @@index([consultant_id, first_vacancy_day])
  @@index([consultant_id, first_job_day])
  @@index([signup_id])
  @@index([lead_id])
}

model field_signup_sync_state {
  consultant_id   String            @id @db.Uuid
  watermark       DateTime?
  last_run_at     DateTime?
  last_ok_at      DateTime?
  last_error_code String?
  last_error      String?
  last_count      Int               @default(0)
  consultant      field_consultants @relation(fields: [consultant_id], references: [id], onDelete: Cascade)
}

// ── remuneração do consultor de campo (F8, contrato §28) ─────
// Versões da regra: SÓ INSERE (nunca UPDATE/DELETE). `created_by` é uuid solto, sem FK: apagar usuário não pode tocar o histórico.
model field_pay_rule_versions {
  id              String   @id @default(uuid()) @db.Uuid
  version         Int      @unique @default(autoincrement())
  valid_from      String
  config          Json
  reason          String?
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now())

  ledger field_earnings_ledger[]

  @@index([valid_from, version])
}

// RAZÃO APPEND-ONLY: trigger no banco barra UPDATE/DELETE; correção = novo lançamento (ajuste/estorno) com motivo.
// Dinheiro em centavos inteiros. FK do consultor é Restrict de propósito (apagar consultor com ganhos é 409).
model field_earnings_ledger {
  id              String   @id @default(uuid()) @db.Uuid
  consultant_id   String   @db.Uuid
  kind            String
  amount_cents    Int
  work_scope      String
  work_day        String?
  work_week       String
  payout_week     String
  rule_version    Int?
  source          String
  reason          String?
  reverses_id     String?  @unique @db.Uuid
  idempotency_key String
  snapshot        Json
  created_by      String?  @db.Uuid
  created_by_name String?
  created_at      DateTime @default(now())

  consultant  field_consultants        @relation(fields: [consultant_id], references: [id], onDelete: Restrict)
  version     field_pay_rule_versions? @relation(fields: [rule_version], references: [version], onDelete: Restrict)
  reverses    field_earnings_ledger?   @relation("estorno", fields: [reverses_id], references: [id], onDelete: Restrict)
  reversed_by field_earnings_ledger?   @relation("estorno")

  @@unique([consultant_id, payout_week, kind, idempotency_key])
  @@index([consultant_id, payout_week])
  @@index([consultant_id, work_week, work_scope, work_day])
}

// Fechamento semanal: só linhas `closed` são gravadas (semana aberta é calculada). Semana fechada não reabre.
model field_payout_periods {
  id             String   @id @default(uuid()) @db.Uuid
  consultant_id  String   @db.Uuid
  week_start     String
  week_end       String
  status         String
  total_cents    Int
  entries        Int
  rule_version   Int
  closed_at      DateTime
  closed_by      String?  @db.Uuid
  closed_by_name String?
  closed_mode    String
  created_at     DateTime @default(now())

  consultant field_consultants @relation(fields: [consultant_id], references: [id], onDelete: Restrict)

  @@unique([consultant_id, week_start])
  @@index([week_start])
}

// ── pagamento por Pix MANUAL (F9, contrato §29) ──────────────
// A obrigação semanal. Colunas de estado mudam SÓ por transição válida + evento na mesma transação;
// trigger no banco barra DELETE e a mudança de consultor/semana/valor/chave Pix/criação.
// O índice único PARCIAL (consultant_id, week_start) WHERE status <> 'cancelled' vive só na migração (Prisma não modela).
model field_payouts {
  id              String    @id @default(uuid()) @db.Uuid
  consultant_id   String    @db.Uuid
  week_start      String
  week_end        String
  due_cents       Int
  pix_key         String?
  pix_key_type    String?
  block_reason    String?
  status          String
  paid_cents      Int?
  paid_at         DateTime?
  paid_by         String?   @db.Uuid
  paid_by_name    String?
  method          String    @default("pix_manual")
  proof_key       String?
  proof_mime      String?
  proof_size      Int?
  note            String?
  diff_reason     String?
  created_by      String?   @db.Uuid
  created_by_name String?
  created_at      DateTime  @default(now())

  consultant field_consultants     @relation(fields: [consultant_id], references: [id], onDelete: Restrict)
  events     field_payout_events[]

  @@index([week_start, status])
  @@index([consultant_id, week_start])
}

// AUDITORIA append-only (trigger barra UPDATE/DELETE). `data` nunca leva a chave Pix.
model field_payout_events {
  id          String   @id @default(uuid()) @db.Uuid
  payout_id   String   @db.Uuid
  type        String
  from_status String?
  to_status   String?
  actor_id    String?  @db.Uuid
  actor_name  String?
  reason      String?
  data        Json     @default("{}")
  created_at  DateTime @default(now())

  payout field_payouts @relation(fields: [payout_id], references: [id], onDelete: Restrict)

  @@index([payout_id, created_at])
}

// ── ganho por cadastro declarado (modo do chefe S3, contrato §32.8) ───────────
// Fato IMUTÁVEL (só INSERT; trigger barra UPDATE/DELETE). Uma por visita e UMA POR EMPRESA em toda a base.
// Nasce dentro do checkout `simples` com result = cadastrou e a flag FIELD_DECLARED_SIGNUPS_ENABLED ligada.
model field_declared_signups {
  id            String   @id @default(uuid()) @db.Uuid
  consultant_id String   @db.Uuid
  visit_id      String   @unique @db.Uuid
  lead_id       String   @unique @db.Uuid
  declared_at   DateTime @default(now())
  declared_day  String
  company_name  String
  rule_version  Int?
  client_id     String   @unique @db.Uuid
  flow          String   @default("simples")

  consultant field_consultants            @relation(fields: [consultant_id], references: [id], onDelete: Restrict)
  visit      field_visits                 @relation(fields: [visit_id], references: [id], onDelete: Restrict)
  lead       leads                        @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  void       field_declared_signup_voids?

  @@index([consultant_id, declared_day])
}

// Anulação: outro fato, nunca edita a declaração. A correção de uma anulação errada é um ajuste manual positivo.
model field_declared_signup_voids {
  id             String   @id @default(uuid()) @db.Uuid
  declared_id    String   @unique @db.Uuid
  reason         String // not_confirmed | duplicate | admin_review | fraud
  note           String
  voided_at      DateTime @default(now())
  voided_by      String?  @db.Uuid
  voided_by_name String?
  client_id      String   @unique @db.Uuid

  declared field_declared_signups @relation(fields: [declared_id], references: [id], onDelete: Restrict)
}

// ── cupons da 1ª contratação (lote C da Lovable, contrato §38) ──
// O pedido é um fato: o trigger `field_vouchers_guard` (só no SQL) barra DELETE e congela consultor, lead, praça, `client_id`,
// as fotos e `created_at`; o estado só muda por compare-and-set com evento na mesma transação. CHECKs e o índice parcial
// `field_vouchers_one_coupon_per_contractor` vivem só na migração.
model field_vouchers {
  id                     String    @id @default(uuid()) @db.Uuid
  client_id              String    @unique @db.Uuid
  consultant_id          String    @db.Uuid
  praca_id               String    @db.Uuid
  lead_id                String    @db.Uuid
  visit_id               String?   @db.Uuid
  company_name           String
  uf                     String
  city                   String
  segment                String
  freelas_per_week       Int
  status                 String    @default("pendente") // pendente | aprovado | reprovado | cancelado
  decision_reason        String?
  decided_by             String?   @db.Uuid
  decided_by_name        String?
  decided_at             DateTime?
  contractor_user_id     String?
  contractor_name        String?
  contractor_source      String? // company_signup | signup_sync | manual
  coupon_status          String? // nao_aplicavel | aguardando_vinculo | aguardando_freela | criado | usado | vencido | desativado | erro
  coupon_code            String?   @unique
  coupon_id              String?
  coupon_params          Json?
  coupon_expires_at      DateTime?
  coupon_error_code      String?
  coupon_error           String?
  coupon_attempts        Int       @default(0)
  coupon_last_attempt_at DateTime?
  coupon_synced_at       DateTime?
  redeemed_at            DateTime?
  created_at             DateTime  @default(now())

  consultant field_consultants      @relation(fields: [consultant_id], references: [id], onDelete: Restrict)
  lead       leads                  @relation(fields: [lead_id], references: [id], onDelete: Restrict)
  visit      field_visits?          @relation(fields: [visit_id], references: [id], onDelete: SetNull)
  events     field_voucher_events[]

  @@index([lead_id, status])
  @@index([consultant_id, created_at])
  @@index([praca_id, created_at])
  @@index([coupon_status])
  @@index([contractor_user_id])
}

// Trilha do pedido: só INSERT (trigger `field_earnings_immutable`). Nunca telefone nem e-mail.
model field_voucher_events {
  id         String   @id @default(uuid()) @db.Uuid
  voucher_id String   @db.Uuid
  type       String
  client_id  String?  @unique @db.Uuid
  actor_kind String // consultor | equipe | sistema
  actor_id   String?  @db.Uuid
  actor_name String?
  reason     String?
  data       Json     @default("{}")
  created_at DateTime @default(now())

  voucher field_vouchers @relation(fields: [voucher_id], references: [id], onDelete: Restrict)

  @@index([voucher_id, created_at])
}

// ── planos de rota (lote D da Lovable, §39) ──────────────────
// Rascunho sem dono nem dia: divide os estabelecimentos de uma área em rotas de até N paradas. Arquiva em vez de apagar.
// `area_id` é coluna simples (sem FK), como em `field_routes`.
model field_route_plans {
  id              String    @id @default(uuid()) @db.Uuid
  praca_id        String    @db.Uuid
  area_id         String?   @db.Uuid
  kind            String    @default("geral") // geral | shoppings | shopping_interno
  parent_lead_id  String?   @db.Uuid
  travel_mode     String // carro | a_pe
  modelo_tempo    String // lovable | roteiro
  params_snapshot Json
  total_leads     Int
  truncated       Boolean   @default(false)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())
  archived_at     DateTime?
  archived_by     String?   @db.Uuid

  praca   pracas                   @relation(fields: [praca_id], references: [id], onDelete: Cascade)
  parent  leads?                   @relation(fields: [parent_lead_id], references: [id], onDelete: SetNull)
  creator users                    @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items   field_route_plan_items[]

  @@index([praca_id, kind, created_at(sort: Desc)])
}

model field_route_plan_items {
  id                     String    @id @default(uuid()) @db.Uuid
  plan_id                String    @db.Uuid
  seq                    Int
  name                   String
  color                  String
  lead_ids               String[]  @db.Uuid
  distance_m             Int
  est_minutes            Int
  assigned_route_id      String?   @db.Uuid
  assigned_consultant_id String?   @db.Uuid
  assigned_day           String?
  assigned_at            DateTime?
  assigned_by            String?   @db.Uuid

  plan       field_route_plans  @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  route      field_routes?      @relation(fields: [assigned_route_id], references: [id], onDelete: SetNull)
  consultant field_consultants? @relation(fields: [assigned_consultant_id], references: [id], onDelete: SetNull)

  @@unique([plan_id, seq])
  @@index([assigned_route_id])
  @@index([assigned_consultant_id, assigned_day])
}

// ── shoppings (lote D da Lovable, §40) ───────────────────────
// Métricas do shopping (lead com `place_kind = 'shopping'`): área do polígono do mapa aberto, lojas mapeadas dentro e a marcação à mão.
model lead_mall_metrics {
  lead_id        String   @id @db.Uuid
  source_ref     String
  geometry_kind  String // poligono | ponto
  area_m2        Int?
  levels         Int?
  pois_mapped    Int?
  measured_at    DateTime
  large_override Boolean?
  updated_by     String?  @db.Uuid
  updated_at     DateTime @updatedAt

  lead leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}
