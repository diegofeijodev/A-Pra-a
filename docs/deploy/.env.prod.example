# /opt/praca/.env no EC2 (chmod 600, nunca versionado). Gere os segredos NO SERVIDOR:
#   openssl rand -hex 32   (JWT_SECRET e POSTGRES_PASSWORD)
# Senhas e chaves de terceiros são digitadas no servidor (read -s), nunca coladas em chat.

# Banco (o compose monta o DATABASE_URL a partir dela)
POSTGRES_PASSWORD=

# Sessão da equipe (mínimo 16 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Endereços: API pública e o site na Vercel (APP_URL e CORS_ORIGINS = URL do site, sem barra no fim)
PUBLIC_URL=https://api-praca.freelaservicosapp.com.br
APP_URL=
CORS_ORIGINS=

# Formulário público: teto por minuto e por IP
PUBLIC_LEADS_PER_MINUTE=10

# Integração com o Freela (conta admin do Freela com as permissões REFERRALS e CONSULTANTS)
FREELA_API_URL=https://api.freelaservicosapp.com.br
FREELA_ADMIN_EMAIL=
FREELA_ADMIN_PASSWORD=
FREELA_PER_CONTACT_MESSAGE=false
# URL BASE do Freela web (o QR do consultor abre ${FREELA_WEB_URL}/cadastro?consultor=CÓDIGO)
FREELA_WEB_URL=https://www.freelaservicosapp.com.br

# Consultores de campo
CAMPO_JWT_EXPIRES_IN=7d
# Fotos das fachadas: vazio = s3 (padrão em produção). Sem bucket, o check-in do consultor não sai do celular.
PHOTO_STORAGE=
S3_BUCKET=
S3_REGION=
# Pasta dentro do bucket. Produção usa o bucket do Freela (freela-uploads, sa-east-1) com S3_PREFIX=praca/
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seed de produção (só para o `npm run seed` da primeira subida)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcionais: e-mails da Rebeca e do Mkt externo (sem eles, rebeca@praca.local / mkt@praca.local)
SEED_REBECA_EMAIL=
SEED_MKT_EMAIL=
