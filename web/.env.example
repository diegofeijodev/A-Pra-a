# Web do PRAÇA (porta 3024). Copie para `.env.local`.

# API do Praça (porta 3014).
NEXT_PUBLIC_API_URL=http://localhost:3014

# Atalho de desenvolvimento: `?demo=1` em /entrar preenche o formulário com a
# conta abaixo. Desligado (ausente) em qualquer host de verdade —
# `diego@praca.local` é conta ADMIN do seed, e com a flag ligada a senha vai
# para o JS estático do navegador.
#
# As três linhas andam juntas: sem a flag, as credenciais não são lidas.
# NEXT_PUBLIC_DEMO_LOGIN=1
# NEXT_PUBLIC_DEMO_EMAIL=diego@praca.local
# NEXT_PUBLIC_DEMO_PASSWORD=praca123
